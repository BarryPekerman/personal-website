# Allow-list: ignore everything, then unignore exactly what's committed.
# Adding a file? Add its !path line too ("nothing to commit" means it's missing).
*

# Directories (needed to traverse into them)
!.github/
!.github/workflows/
!cmd/
!cmd/server/
!content/
!content/projects/
!docs/
!internal/
!internal/geo/
!internal/geo/gen/
!internal/handlers/
!internal/shell/
!internal/status/
!scripts/
!web/
!web/static/
!web/static/css/
!web/static/js/
!web/static/vendor/
!web/templates/

# Repo root
!.dockerignore
!.gitignore
!.golangci.yml
!Dockerfile
!README.md
!go.mod
!go.sum
!run-local.sh

# CI
!.github/workflows/ci.yml
!.github/workflows/ghcr-retention.yml

# Server
!cmd/server/main.go
!cmd/server/main_test.go
!cmd/server/pages.go
!cmd/server/pages_test.go
!internal/geo/geo.go
!internal/geo/geo_test.go
!internal/geo/places.json
!internal/geo/gen/main.go
!internal/handlers/terminal.go
!internal/handlers/terminal_test.go
!internal/shell/interface.go
!internal/shell/pipes.go
!internal/shell/virtual.go
!internal/shell/virtual_test.go
!internal/status/status.go
!internal/status/status_test.go

# Browser check (CI's page job)
!scripts/pagecheck.py

# What visitors browse in the terminal (embedded in the binary)
!content/.motd
!content/contact_info.md
!content/content.go
!content/content_test.go
!content/cv.txt
!content/projects/k8s-cluster-vagrant.md
!content/projects/oke-version-guard.md
!content/projects/portfolio-terminal.md
!content/projects/terraform-aws-chatops.md
!content/projects/the-handover.md

# Front end (embedded in the binary)
!web/web.go
!web/static/css/home.css
!web/static/css/terminal-page.css
!web/static/js/audio.js
!web/static/js/home.js
!web/static/js/routemap.js
!web/static/js/terminal-page.js
!web/static/js/terminal.js
!web/templates/home.html
!web/templates/index.html

# Third-party front end, as published on npm (versions in web/static/vendor/README.md)
!web/static/vendor/README.md
!web/static/vendor/LICENSE.*
!web/static/vendor/addon-fit.js
!web/static/vendor/addon-web-links.js
!web/static/vendor/land-110m.json
!web/static/vendor/topojson-client.min.js
!web/static/vendor/xterm.css
!web/static/vendor/xterm.js

# Docs
!docs/NOTES.md
