# Custom Alpine image for portfolio terminal guests
FROM alpine:latest

# Install essential packages
RUN apk add --no-cache \
    bash \
    coreutils \
    less \
    grep \
    sed \
    gawk \
    curl \
    wget \
    nano \
    vim \
    tree \
    file \
    findutils

# Create guest user (use different name to avoid conflicts)
RUN adduser -D -s /bin/bash -u 1000 portfoliouser

# Create home directory structure
RUN mkdir -p /home/portfoliouser/projects && \
    chown -R portfoliouser:portfoliouser /home/portfoliouser

# Set up shell configuration
COPY --chown=portfoliouser:portfoliouser manifests/docker/guest-profile /home/portfoliouser/.profile
COPY --chown=portfoliouser:portfoliouser manifests/docker/guest-bashrc /home/portfoliouser/.bashrc

# Create a minimal motd
RUN echo "Welcome to your isolated Portfolio Terminal!" > /etc/motd

# Switch to portfoliouser
USER portfoliouser
WORKDIR /home/portfoliouser

# Default command (will be overridden by Kubernetes)
CMD ["/bin/bash", "-l"]
