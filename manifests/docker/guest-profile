# Portfolio Terminal Profile
export PS1='\[\033[1;32m\]guest@portfolio\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '

# Set environment
export TERM=xterm-256color
export EDITOR=nano
export PAGER=less

# Aliases for easy navigation
alias cv='cat cv.txt'
alias resume='cat cv.txt'
alias contact='cat contact_info.md'
alias projects='ls -la projects/'
alias ll='ls -la'
alias la='ls -la'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias less='less -R'

# Custom help function
help() {
    echo ""
    echo "🎯 PORTFOLIO TERMINAL - Available Commands"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "📋 PORTFOLIO NAVIGATION:"
    echo "  cv, resume     - View full CV/resume"
    echo "  contact        - Contact information and social links"
    echo "  projects       - List all technical projects"
    echo "  cat projects/[file] - View specific project details"
    echo ""
    echo "📁 FILE OPERATIONS:"
    echo "  ls, ll, la     - List files and directories"
    echo "  cat [file]     - Display file contents"
    echo "  less [file]    - View file with paging"
    echo "  grep [pattern] - Search within files"
    echo "  tree           - Show directory structure"
    echo ""
    echo "🛠️ UTILITIES:"
    echo "  clear          - Clear the terminal screen"
