# Minimal version using only standard library
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy source code
COPY cmd/server/main_minimal.go ./main.go
COPY web/ ./web/

# Build with standard library only
RUN go build -o main main.go

# Final stage
FROM alpine:latest

# Create non-root user first
RUN adduser -D -s /bin/sh appuser

# Create app directory and set ownership
RUN mkdir /app && chown appuser:appuser /app

# Copy the binary and web assets
COPY --from=builder /app/main /app/
COPY --from=builder /app/web /app/web/

# Copy index.html to web root for easier serving
RUN cp /app/web/templates/index.html /app/web/

# Set proper permissions for appuser
RUN chown -R appuser:appuser /app && chmod +x /app/main

USER appuser
WORKDIR /app

EXPOSE 8080

CMD ["./main"]
